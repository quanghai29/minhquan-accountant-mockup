              [
                ['Ngày hạch toán', selectedRow.ngay],
                ['Ngày chứng từ', selectedRow.ngay_ct],
                ['Số chứng từ', selectedRow.so],
                ['Đối tượng', selectedRow.doi_tuong || selectedRow.nguoi_nhan || '—'],
                ['Loại chứng từ', selectedRow.loai],
                ['Diễn giải', selectedRow.dien_giai],
              ].map(([l, v]) => React.createElement('div', {
                key: l, style: { display: 'flex', justifyContent: 'space-between', padding: '7px 0', borderBottom: `1px solid ${T.border}`, fontSize: 12 }
