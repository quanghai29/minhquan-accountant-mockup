                    React.createElement('span', null, `${d.sl.toLocaleString('vi-VN')} ${d.dvt} × ${fmtMoney(d.don_gia)}`),
                    React.createElement('span', { className: 'num', style: { color: T.text, fontWeight: 500 } }, fmtMoney(d.tt))
