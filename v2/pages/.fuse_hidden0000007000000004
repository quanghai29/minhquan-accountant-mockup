  // ── BC Tình hình tài chính ───────────────────────────────
  window.PageBCTaiChinh = function () {
    const tongTonKho = MOCK.bcTonKho.reduce((s, r) => s + (r.ck_gt || 0), 0);
    const tongPhaiThu = MOCK.bcCongNoThu.reduce((s, r) => s + (r.no_cuoi_ky || 0), 0);
    const tongPhaiTra = MOCK.bcCongNoTra.reduce((s, r) => s + (r.no_cuoi_ky || 0), 0);
    const tienGui = MOCK.tkNH.reduce((s, r) => s + r.so_du, 0);
    const tienMat = 275000000;

    const lines = [
      { label: 'Tiền mặt',              value: tienMat,     tone: 'positive' },
      { label: 'Tiền gửi ngân hàng',    value: tienGui,     tone: 'positive' },
      { label: 'Phải thu khách hàng',   value: tongPhaiThu, tone: 'neutral' },
      { label: 'Hàng tồn kho',           value: tongTonKho,  tone: 'neutral' },
      { label: 'Phải trả nhà cung cấp', value: -tongPhaiTra,tone: 'negative' },
    ];
    const tongTaiSan = tienMat + tienGui + tongPhaiThu + tongTonKho;
    const vonChuSoHuu = tongTaiSan - tongPhaiTra;

    return React.createElement('div', {
      style: { flex: 1, overflow: 'auto', padding: '18px 22px' }
