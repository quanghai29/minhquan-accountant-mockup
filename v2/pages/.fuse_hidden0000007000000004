          React.createElement('h3', { style: { fontSize: 14, fontWeight: 700, color: T.text, margin: '0 0 14px' } }, 'TÀI SẢN'),
          lines.slice(0, 4).map((l, i) => React.createElement('div', {
            key: i, style: { display: 'flex', justifyContent: 'space-between', padding: '10px 0', borderBottom: `1px solid ${T.border}` }
          },
            React.createElement('span', { style: { fontSize: 13, color: T.textMid } }, l.label),
            React.createElement(MoneyCell, { value: l.value, tone: l.tone })
          )),
          React.createElement('div', {
            style: { display: 'flex', justifyContent: 'space-between', padding: '14px 0 0', fontWeight: 700 }
          },
            React.createElement('span', { style: { fontSize: 13, color: T.text } }, 'TỔNG TÀI SẢN'),
            React.createElement('span', { className: 'num', style: { fontSize: 17, color: T.text, fontWeight: 500, letterSpacing: '-0.02em' } }, fmtMoney(tongTaiSan))
          )
        ),
        React.createElement('div', { style: { ...SS.card, padding: 20 } },
          React.createElement('h3', { style: { fontSize: 14, fontWeight: 700, color: T.text, margin: '0 0 14px' } }, 'NGUỒN VỐN'),
          React.createElement('div', {
            style: { display: 'flex', justifyContent: 'space-between', padding: '10px 0', borderBottom: `1px solid ${T.border}` }
          },
            React.createElement('span', { style: { fontSize: 13, color: T.textMid } }, 'Phải trả nhà cung cấp'),
            React.createElement(MoneyCell, { value: tongPhaiTra, tone: 'negative' })
          ),
          React.createElement('div', {
            style: { display: 'flex', justifyContent: 'space-between', padding: '10px 0', borderBottom: `1px solid ${T.border}` }
          },
            React.createElement('span', { style: { fontSize: 13, color: T.textMid } }, 'Vốn chủ sở hữu'),
            React.createElement(MoneyCell, { value: vonChuSoHuu, tone: 'positive' })
          ),
          React.createElement('div', {
            style: { display: 'flex', justifyContent: 'space-between', padding: '14px 0 0', fontWeight: 700 }
