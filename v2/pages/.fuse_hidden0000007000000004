  // ── BC Doanh thu ───────────────────────────────────────────
  window.PageBCDoanhThu = function () {
    // Group banHang by customer
    const byKH = {};
    MOCK.banHang.forEach(r => {
      if (!byKH[r.ma_kh]) byKH[r.ma_kh] = { ma: r.ma_kh, ten: r.kh, so_ct: 0, doanh_thu: 0, da_thu: 0 };
