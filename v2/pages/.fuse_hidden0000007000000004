      React.createElement('div', { style: { display: 'flex', gap: 10, marginBottom: 18 } },
        React.createElement(KPICard, { label: 'Tổng tài sản',     value: fmtMoney(tongTaiSan),   sub: '30/04/2026', tone: 'neutral', icon: 'baocao' }),
        React.createElement(KPICard, { label: 'Nợ phải trả',       value: fmtMoney(tongPhaiTra),  sub: 'Nhà cung cấp',tone: 'negative', icon: 'muahang' }),
        React.createElement(KPICard, { label: 'Vốn chủ sở hữu',    value: fmtMoney(vonChuSoHuu), sub: 'Tài sản — Nợ',tone: 'positive', icon: 'tienthu' })
      ),

      React.createElement('div', { style: { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 } },
