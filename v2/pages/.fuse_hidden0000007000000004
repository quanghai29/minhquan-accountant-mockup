      byKH[r.ma_kh].doanh_thu += r.tong;
      byKH[r.ma_kh].da_thu += (r.tt_thanh_toan === 'Đã thanh toán' ? r.tong : 0);
    });
    const rows = Object.values(byKH).map(r => ({ ...r, con_thu: r.doanh_thu - r.da_thu }));
    const cols = [
      { key: 'ma',        label: 'Mã KH',         width: 110, bold: true, link: true },
      { key: 'ten',       label: 'Khách hàng' },
